# =====================================================================
# TigerAI ARM64 Global Tuning Profile (Master Sync v6.9.9)
# Synced from src/0105-AMD Verified Enterprise Configurations
# =====================================================================

# --- 1) Global Localization & System ---
TZ=Asia/Taipei
TIMEZONE=Asia/Taipei
PG_LANG=zh-TW
PORTAINER_PORT=9000

# --- 2) Database Excellence (Postgres v17 + pgAdmin 8.14) ---
PG_USER=adm
PG_PASS='CHANGE_ME'
PG_DB_NAME=tigerai
PG_PORT=5432

PGADMIN_PORT=8000
PGADMIN_EMAIL=CHANGE_ME
PGADMIN_PASS='CHANGE_ME'

# --- 3) AI Interface (Ollama + OpenWebUI HA) ---
OWUI_PORT=8080
OWUI_SECRET_KEY=CHANGE_ME
OWUI_DB_NAME=openwebui  # OpenWebUI dedicated DB (public schema; DB isolation from n8n/litellm)

# Ollama Performance
OLLAMA_PORT=11434
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
# Unset, ollama picks a tier from detected VRAM (256k on a 128GB box).
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_QUEUE=512
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_ORIGINS=*

# OpenWebUI Performance
GUNICORN_WORKERS=4
AIOHTTP_TIMEOUT=900

# --- 4) Automation (n8n Enterprise v2.x) ---
# Credential encryption key (was N8N_SECRET). Never change it after deployment.
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_BINARY_DATA_MODE=filesystem
N8N_DIR=/home/wrt/TigerAI/node/n8n
FILES_DIR=/home/wrt/TigerAI/node/n8n/files
N8N_PORT=5678

# n8n DB / Redis connection (independently settable — may point to a different
# DB host/database or Redis than the generic PG_* / Redis above).
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=adm
# Defaults to PG_PASS. Uncomment only if n8n uses a different database password.
# DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_SCHEMA=public
REDIS_HOST=redis
DB_TYPE=postgresdb
WORKER_CONCURRENCY=5
N8N_URL=
N8N_CORS_ALLOW_ORIGIN=*

# n8n Metrics — free Prometheus endpoint; both main + worker expose /metrics
N8N_METRICS=true
N8N_METRICS_INCLUDE_QUEUE_METRICS=true

# n8n stdout as JSON (one JSON object per line) so Alloy/Loki can parse fields
N8N_LOG_FORMAT=json

# n8n AI Assistant master switch — turns sandbox (n8n-sandbox-service) and SearXNG on and off together. Same value on all platforms.
# Both only serve the AI Assistant; two switches would just be one more thing to get wrong. Default false: an upgraded
# host does not suddenly gain a privileged DinD or take another host port. deploy.sh brings them up only for
# true, TRUE, True, 1, yes or on (yes/on lowercase only); anything else is off. Set it back to false and redeploy
# 04 (all / main / worker / restart) to stop and remove the sandbox and SearXNG containers (their volumes are kept).
N8N_AI_ASSISTANT_ENABLED=false
# One version for all three sandbox images; change it here to move them together.
SANDBOX_VERSION=1.3.4
# The next three are sandbox-internal credentials: SANDBOX_API_KEYS is also handed to n8n as
# N8N_SANDBOX_SERVICE_API_KEY; the other two must match on the api and runner side.
# With N8N_AI_ASSISTANT_ENABLED=true, CHANGE_ME here is blocked by 04's pre-deploy.sh. Generate: openssl rand -hex 32
SANDBOX_API_KEYS='CHANGE_ME'
SANDBOX_REGISTRATION_TOKEN='CHANGE_ME'
SANDBOX_RUNNER_API_KEY='CHANGE_ME'
# compose defines only sandbox-runner-1, so only 1 is supported for now.
SANDBOX_NUM_RUNNERS=1
# Output directory for the mTLS material (includes the CA private key). Kept outside the repo so it survives `down`; delete it to re-sign.
# WARNING: it is under BASE_DIR, so backup-tigerai.sh packs the CA private key into the backup; keep backups as safe as the key.
SANDBOX_TLS_DIR=/home/wrt/TigerAI/node/sandbox
# SearXNG: host port 8080 is taken by openwebui, hence 30366; bound to 127.0.0.1 only, not reachable from the LAN.
SEARXNG_PORT=30366
# n8n goes over the container network; keep this value. For local browser debugging open http://127.0.0.1:30366/
SEARXNG_BASE_URL=http://searxng:8080/
# With N8N_AI_ASSISTANT_ENABLED=true, a placeholder here is blocked by 04's pre-deploy.sh. Generate: openssl rand -hex 32
SEARXNG_SECRET='CHANGE_ME'

# --- 5) RAG & Memory ---
QDRANT_PORT=6333
# Qdrant search thread count (QDRANT__STORAGE__PERFORMANCE__MAX_SEARCH_THREADS)
QDRANT_MAX_THREADS=4
# Qdrant 6333 is bound to 0.0.0.0 (the LAN plaintext path is kept on purpose); the API key is the only access control.
#   Empty means no authentication at all, and the container still starts with no symptom. 05's pre-deploy.sh blocks the placeholder.
# Equal keys make the read-only key an admin key (05 only warns). Generate each one separately: openssl rand -hex 32
QDRANT_API_KEY='CHANGE_ME'
QDRANT_READ_ONLY_API_KEY='CHANGE_ME'
MQTT_BROKER_PORT=443
HTTP_DOCLING_PORT=5001
SHM_SIZE_RAG=16gb
# Data root directory for bind-mounts (mosquitto/qdrant/docling etc.)
BASE_DIR=/home/wrt/TigerAI

# --- 7) Monitoring & Observability ---
GRAFANA_PORT=3000
GRAFANA_PASS='CHANGE_ME'

# Grafana uses PostgreSQL as its internal DB (mirror k3s); this DB is auto-created
# by 10-observability-grafana/deploy.sh. Reuses PG_USER / PG_PASS / PG_PORT above.
GF_DB_NAME=grafana

# Grafana Alloy (collects container logs -> Loki)
ALLOY_IMAGE=grafana/alloy:v1.17.1

# --- 8) Backup ---
PG_CONTAINER=postgres
# DATA_DIRS: unset backs up everything under BASE_DIR; set (space-separated) to narrow.
# DATA_DIRS="/home/wrt/TigerAI/node/n8n /home/wrt/TigerAI/qdrant"

# --- 8) Image Versions ---
POSTGRES_IMAGE=postgres:17-alpine
PGADMIN_IMAGE=dpage/pgadmin4:latest
OLLAMA_IMAGE=ollama/ollama:latest
OWUI_IMAGE=ghcr.io/open-webui/open-webui:main
REDIS_IMAGE=redis:8-alpine
N8N_IMAGE=docker.n8n.io/n8nio/n8n:stable
SEARXNG_IMAGE=searxng/searxng:latest
# CPU only — no aarch64 GPU image published for Qdrant
QDRANT_IMAGE=qdrant/qdrant:latest
MOSQUITTO_IMAGE=eclipse-mosquitto:latest
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve-cpu:latest
WEBSSH_IMAGE=jrohy/webssh:latest
PORTAINER_IMAGE=portainer/portainer-ce:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
LOKI_IMAGE=grafana/loki:latest
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:latest
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.5.2-4.8.1-ubuntu22.04

# --- MQTT broker credentials ---
# Used by the mosquitto service, its healthcheck, tiger-monitor.sh and
# monitor_device.py. The broker no longer allows anonymous connections,
# so every consumer must present these.
MQTT_USERNAME=tigerai
MQTT_PASSWORD='CHANGE_ME'
