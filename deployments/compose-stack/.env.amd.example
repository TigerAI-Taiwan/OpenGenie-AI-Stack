# =====================================================================
# TigerAI ARM64 Global Tuning Profile (Master Sync v6.9.9)
# Synced from src/0105-AMD Verified Enterprise Configurations
# =====================================================================

# --- Auto-Tuning Configuration ---
TIGER_OPTIMIZATION_PROFILE=BALANCED
TIGER_CPU_THREADS=24
TIGER_N8N_WORKERS=5
TIGER_LOG_MAX_SIZE=50m
TIGER_GPU_TYPE=AMD
TIGER_VRAM=0
CLUSTER_MODE=standalone
PRIMARY_NODE_IP=127.0.0.1
INSTALL_HA=false

# --- 1) Global Localization & System ---
TZ=Asia/Taipei
TIMEZONE=Asia/Taipei
PG_LANG=zh-TW
PORTAINER_PORT=9000

# --- 2) Database Excellence (Postgres v17 + pgAdmin 8.14) ---
PG_USER=adm
PG_PASS='CHANGE_ME'
PG_DB_NAME=tigerai
PG_DB=tigerai
PG_PORT=5432

PGADMIN_PORT=8000
PGADMIN_EMAIL=CHANGE_ME
PGADMIN_PASS='CHANGE_ME'

# --- 3) AI Interface (Ollama + OpenWebUI HA) ---
OWUI_PORT=8080
OWUI_SECRET_KEY=CHANGE_ME
OWUI_DB_NAME=openwebui  # OpenWebUI dedicated DB (public schema; DB isolation from n8n/litellm)
PG_HOST=postgres
SHM_SIZE=4gb

# Ollama Performance
OLLAMA_PORT=11434
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_QUEUE=512
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_ORIGINS=*

# OpenWebUI Performance
GUNICORN_WORKERS=4
AIOHTTP_TIMEOUT=900

# --- 4) Automation (n8n Enterprise v2.x) ---
# Credential encryption key (was N8N_SECRET). Never change it after deployment.
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_BINARY_DATA_MODE=filesystem
N8N_DIR=/home/wrt/TigerAI/node/n8n
FILES_DIR=/home/wrt/TigerAI/node/n8n/files
N8N_PORT=5678

# n8n DB / Redis connection (independently settable — may point to a different
# DB host/database or Redis than the generic PG_* / Redis above).
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=adm
DB_POSTGRESDB_PASSWORD='CHANGE_ME'
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_SCHEMA=public
REDIS_HOST=redis
DB_TYPE=postgresdb
WORKER_CONCURRENCY=5
N8N_URL=
N8N_CORS_ALLOW_ORIGIN=*

# n8n Metrics — free Prometheus endpoint; both main + worker expose /metrics
N8N_METRICS=true
N8N_METRICS_INCLUDE_QUEUE_METRICS=true

# n8n stdout as JSON (one JSON object per line) so Alloy/Loki can parse fields
N8N_LOG_FORMAT=json

# --- 5) RAG & Memory ---
QDRANT_PORT=6333
# Qdrant search thread count (QDRANT__STORAGE__PERFORMANCE__MAX_SEARCH_THREADS)
QDRANT_MAX_THREADS=4
MQTT_BROKER_PORT=443
HTTP_DOCLING_PORT=5001
SHM_SIZE_RAG=16gb
DOCLING_SHM=16gb
MQTT_IMAGE=eclipse-mosquitto:latest
# Data root directory for bind-mounts (mosquitto/qdrant/docling etc.)
BASE_DIR=/home/wrt/TigerAI

# --- 7) Monitoring & Observability ---
GRAFANA_PORT=3000
GRAFANA_PASS='CHANGE_ME'

# Grafana uses PostgreSQL as its internal DB (mirror k3s); this DB is auto-created
# by 10-observability-grafana/deploy.sh. Reuses PG_USER / PG_PASS / PG_PORT above.
GF_DB_NAME=grafana

# Grafana Alloy (collects container logs -> Loki)
ALLOY_IMAGE=grafana/alloy:v1.17.1

# --- 8) Backup ---
PG_CONTAINER=postgres
# DATA_DIRS: unset backs up everything under BASE_DIR; set (space-separated) to narrow.
# DATA_DIRS="/home/wrt/TigerAI/node/n8n /home/wrt/TigerAI/qdrant"

# --- 9) Lemonade AI Core (Docker) ---
LEMONADE_API_KEY=
MODELS_DIR=/home/wrt/TigerAI/models
GGML_VULKAN_DEVICE_EDU=0
GGML_VULKAN_DEVICE_RAG=0
GGML_VULKAN_DEVICE_EMBED=0

# --- 8) Image Versions ---
POSTGRES_IMAGE=postgres:17-alpine
PGADMIN_IMAGE=dpage/pgadmin4:latest
OLLAMA_IMAGE=ollama/ollama:latest
OWUI_IMAGE=ghcr.io/open-webui/open-webui:main
REDIS_IMAGE=redis/redis-stack-server:latest
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
# AMD GPU build (CPU fallback if GPU unavailable)
QDRANT_IMAGE=qdrant/qdrant:gpu-amd-latest
MOSQUITTO_IMAGE=eclipse-mosquitto:latest
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve-cpu:latest
WEBSSH_IMAGE=jrohy/webssh:latest
PORTAINER_IMAGE=portainer/portainer-ce:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
LOKI_IMAGE=grafana/loki:latest
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:latest
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.5.2-4.8.1-ubuntu22.04
ROCM_EXPORTER_IMAGE=rocm/device-metrics-exporter:v1.4.2

# --- MQTT broker credentials ---
# Used by the mosquitto service, its healthcheck, tiger-monitor.sh and
# monitor_device.py. The broker no longer allows anonymous connections,
# so every consumer must present these.
MQTT_USERNAME=tigerai
MQTT_PASSWORD='CHANGE_ME'
