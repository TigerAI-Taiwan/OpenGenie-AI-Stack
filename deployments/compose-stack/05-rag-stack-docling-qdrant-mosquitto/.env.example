# =====================================================================
# Device MQTT Configuration (module-level overrides)
# =====================================================================
# The broker credentials live in the stack-level .env as MQTT_USERNAME /
# MQTT_PASSWORD, because the mosquitto service, its healthcheck,
# tiger-monitor.sh and monitor_device.py all authenticate with the same pair.
# Only set them here to override for this module.
#
# These replace the former LANDING_LOCAL_MQTT_* names, which were vestigial —
# there is no landing component in this stack. The old default port was 9013,
# which nothing in this stack listens on, so monitor_device.py could never
# connect. It is 1883 now, matching the mosquitto service.

# Where monitor_device.py reaches the broker.
# MQTT_HOST=localhost
# MQTT_PORT=1883

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=5
